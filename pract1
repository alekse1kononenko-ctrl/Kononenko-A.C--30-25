#!/bin/bash
ext="$1"
files=()
while IFS= read -r -d '' file
do
        files+=("$file")
done < <(find . -maxdepth 1 -type f -name "*.$ext" -print0)
if ((${#files[@]} > 0)); then
        tar -cf archive.tar "${files[@]}"
else
        echo "files empty"
fi

