#!/bin/bash

path="$1"
declare -A count
declare -A files
while IFS= read -r file
do
        hash=$(sha256sum "$file" | cut -d ' ' -f1)
        ((count["$hash"]++))
        files["$hash"]+="$file"$'\n'

done < <(find "$path" -type f)
for hash in "${!count[@]}"
do
        if ((count["$hash"] > 1)); then
                printf '%s' "${files[$hash]}"
        fi
done


