for file in *.c *.js *.py
do
        f_line=$(head -n 1 "$file")
        case "$file" in
                *.c|*.js)
                if echo "$f_line" | grep -qE '^[[:space:]]*(//|/\*)'; then
                        echo "$f_line"
                fi
                ;;
                *.py)
                if echo "$f_line" | grep -qE '^[[:space:]]*#'; then
                        echo "$f_line"
                fi
                ;;
        esac
done

